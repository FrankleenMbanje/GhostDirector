# GhostDirector — environment configuration (copy to .env and fill in)
# NEVER commit the real .env. All values below are PLACEHOLDERS.

# ── Database (Phase 7/8) ──────────────────────────
# Production source of truth for production state. PostgreSQL required in
# production; a local SQLite mirror is used automatically when unset.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── AI / content APIs ─────────────────────────────
# Google Gemini (script, research, visual selection, image generation)
GEMINI_API_KEY=

# Stock footage / photos
PEXELS_API_KEY=
# Optional secondary stock source
PIXABAY_API_KEY=

# Optional premium TTS (edge-tts is the free default)
ELEVENLABS_API_KEY=

# ── YouTube upload (per-channel OAuth) ────────────
# The uploader uses InstalledAppFlow with client_secrets.json on first run
# and stores per-channel tokens in youtube_token.<channel>.json (git-ignored).
# Alternatively provide a refresh token directly:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Scheduler / paths (optional overrides) ────────
# Production timezone for the daily run (default Africa/Harare per spec)
GD_TIMEZONE=Africa/Harare
# Daily run hour in the production timezone (default 10)
GD_DAILY_HOUR=10
# Machine-specific output location (default: ./output next to the code)
GD_OUTPUT_DIR=
